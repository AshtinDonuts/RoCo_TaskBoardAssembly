+def _align_adam_slots_to_grads(optimizer) -> None:
+    """Make restored Adam state compatible with the current FSDP gradient dtype/device."""
+    base_optimizer = getattr(optimizer, "optimizer", optimizer)
+    for group in base_optimizer.param_groups:
+        group["foreach"] = False
+        for param in group["params"]:
+            if param.grad is None:
+                continue
+            state = base_optimizer.state.get(param)
+            if not state:
+                continue
+            grad = param.grad
+            for key, value in list(state.items()):
+                if key == "step" or not torch.is_tensor(value) or not torch.is_floating_point(value):
+                    continue
+                if value.device != grad.device or value.dtype != grad.dtype:
+                    state[key] = value.to(device=grad.device, dtype=grad.dtype)
