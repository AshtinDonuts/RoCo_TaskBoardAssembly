+def _align_optimizer_slot_tensors(optimizer) -> None:
+    """Align restored optimizer slot tensors with their parameters after FSDP resharding.
+
+    Some PyTorch/Accelerate/FSDP combinations restore Adam slot tensors on a different device than
+    the flattened parameter. Keep the saved dtype because FSDP may produce fp32 gradients for bf16
+    parameters, and Adam's moment tensors must follow the gradient dtype on the scalar path.
+    """
+    base_optimizer = getattr(optimizer, "optimizer", optimizer)
+    for group in base_optimizer.param_groups:
+        group["foreach"] = False
+        for param in group["params"]:
+            state = base_optimizer.state.get(param)
+            if not state:
+                continue
+            for key, value in list(state.items()):
+                if key == "step" or not torch.is_tensor(value):
+                    continue
+                if value.device != param.device:
+                    state[key] = value.to(device=param.device)
 
 
